{
  "name": "dsh-stuck-fix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "dsh 桌面端卡死引信拆除：preload 取色观察者在 head 变动风暴里会把主线程占死，这里在风暴起势时替它跑收尾（仅 Windows 桌面端）",
  "exports": {
    ".": "./stuck-fix.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "stuck-fix.mjs",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
