{
  "name": "dsh-titlebar-perf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "dsh 桌面端标题栏取色性能修补：把 preload 的取色探针摘出文档，消掉每次 DOM 变更触发的整篇强制重排（仅 Windows 桌面端）",
  "exports": {
    ".": "./titlebar-perf.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "titlebar-perf.mjs",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
