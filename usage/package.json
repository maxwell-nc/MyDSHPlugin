{
  "name": "dsh-usage",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "dsh token 用量统计插件（host 半边 + Web 客户端半边）；含「规范模型名」与「合并徽章」两个展示开关（后者默认开，把 -TokenPlan / -Free / 构建号这类末尾标记并成一个模型），图例每行显示该模型自己的平均输出速度与平均首字延迟（TTFT）",
  "scripts": {
    "test:model-merge": "node test-model-merge.mjs",
    "test:timing": "node test-timing.mjs"
  },
  "exports": {
    ".": "./usage.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "usage.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["dsh-model-name"],
      "external": ["dsh-model-name"]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}