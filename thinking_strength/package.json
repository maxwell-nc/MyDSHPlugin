{
  "name": "dsh-thinking-strength",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "自绘模型选择座（斜杠后短名按钮 + 直达模型列表，末尾的套餐/渠道/构建标记画成同色徽章，只改呈现不动 id）与 5 档思考强度滑块（默认/低/中/高/最大）；按模型记住思考强度",
  "exports": {
    ".": "./thinking-strength.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "thinking-strength.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "scripts": {
    "test": "node test/memory.test.mjs && node test/client.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-model-name"
      ],
      "external": [
        "dsh-model-name"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "dsh-model-name": "*"
  },
  "peerDependenciesMeta": {
    "dsh-model-name": {
      "optional": true
    }
  }
}
