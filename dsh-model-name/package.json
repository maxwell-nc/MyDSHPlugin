{
  "name": "dsh-model-name",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "共享的模型显示名规范化（display-name dictionary）：把 deepseek→DeepSeek、glm→GLM、qwen→Qwen、mimo→MiMo、minimax→MiniMax、v+数字→V+数字、-flash→-Flash 等统一成规范显示名，供 usage / thinking 等客户端插件 require 复用。纯显示层，不改变存储/匹配用的模型 id。",
  "exports": {
    ".": "./model-name.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "model-name.mjs",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}