{
  "name": "dsh-ui-retry",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "description": "dsh 消息编辑 / 重试插件（host 半边 + Web 客户端半边）",
  "exports": {
    ".": "./retry.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "retry.mjs",
    "lib/origin.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}