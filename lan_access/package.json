{
  "name": "dsh-lan-access",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "dsh 局域网访问插件（host 半边：带鉴权的反向代理 + 二维码接口；Web 客户端半边：侧边栏入口与面板）",
  "exports": {
    ".": "./lan_access.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lan_access.mjs",
    "lib/proxy.mjs",
    "lib/qr.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}